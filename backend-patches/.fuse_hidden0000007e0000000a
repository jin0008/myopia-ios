async function verifyKakaoAccessToken(token: string): Promise<{ subject: string; email: string | null }> {
  const resp = await fetch("https://kapi.kakao.com/v2/user/me", {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!resp.ok) throw new Error("kakao verify failed");
  const data: any = await resp.json();
  return { subject: String(data.id), email: data.kakao_account?.email ?? null };
}

async function verifyNaverAccessToken(token: string): Promise<{ subject: string; email: string | null }> {
  const resp = await fetch("https://openapi.naver.com/v1/nid/me", {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!resp.ok) throw new Error("naver verify failed");
  const data: any = await resp.json();
  return { subject: String(data.response?.id), email: data.response?.email ?? null };
}

